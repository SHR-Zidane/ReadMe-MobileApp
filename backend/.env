# ──────────────────────────────────────────────
# ReadMe - Backend (Node.js / Express / Sequelize)
# ──────────────────────────────────────────────

# Serveur
PORT=3000
NODE_ENV=development

# Base de données (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=readme
DB_USER=root
DB_PASSWORD=

# Dialecte Sequelize (mysql / mariadb / postgres / sqlite)
DB_DIALECT=mysql

# CORS - Origines autorisées (* = tout ouvert en dev)
CORS_ORIGIN=*

# Upload - Fichiers EPUB
UPLOAD_DIR=public
MAX_FILE_SIZE=52428800

# Python - Script d'extraction des métadonnées EPUB
PYTHON_PATH=python
PARSER_SCRIPT=parser.py

# Sécurité (à changer en prod)
JWT_SECRET=change-me-to-a-secure-random-string
